new file mode 100644
index 0000000..1133d19
--- /dev/null
+++ b/backend/authenticUser/utils/jwtUtils.js
@@ -0,0 +1,33 @@
+const { config } = require("configs");
+const jwt = require("jsonwebtoken");
+
+module.exports = {
+  sign: (userId, userRole) => {
+    const access_token = jwt.sign(
+      {
+        userId: userId,
+        role: userRole,
+      },
+      config.jwt.secret,
+      {
+        expiresIn: config.jwt.ttl,
+      }
+    );
+
+    return access_token;
+  },
+  signRefreshToken: (userId, userRole) => {
+    const refresh_token = jwt.sign(
+      {
+        userId: userId,
+        role: userRole,
+      },
+      config.jwt.secret,
+      {
+        expiresIn: "1y",
+      }
+    );
+
+    return refresh_token;
+  },
+};
diff --git a/backend/authenticUser/utils/responseUtils.js b/backend/authenticUser/utils/responseUtils.js
new file mode 100644
