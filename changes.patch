diff --git a/assets/css/home_style.css b/assets/css/home_style.css
new file mode 100644
index 0000000..6c54db5
--- /dev/null
+++ b/assets/css/home_style.css
@@ -0,0 +1,222 @@
+:root {
+    --heading-font: 'Playfair Display', serif;
+    --body-font: 'Inter', sans-serif;
+    --text-primary: #000;
+    --text-secondary: #6c757d;
+    --border-color: #e0e0e0;
+    --background-color: #ffffff;
+}
+html, body {
+    font-family: var(--body-font);
+    background-color: var(--background-color);
+    color: var(--text-primary);
+}
+.logo {
+    font-family: var(--heading-font);
+    font-size: 1.6rem;
+    font-weight: 700;
+    color: #242424 !important;
+}
+.navbar {
+    box-shadow: none;
+}
+.search-bar-group {
+    max-width: 300px;
+    background-color: #f3f3f3;
+    border: 1px solid var(--border-color);
+    border-radius: 999px;
+    transition: background-color 0.2s, border-color 0.2s;
+}
+
+.search-bar-group:focus-within {
+    background-color: #fff;
+    border-color: #ccc;
+}
+
+.search-bar-group .form-control {
+    height: 32px;
+}
+
+.search-bar-group .form-control::placeholder {
+    color: #8a8a8a;
+}
+.nav-category-bar {
+    position: sticky;
+    top: 0;
+    z-index: 1030;
+    background: #fff;
+    border-bottom: 1px solid #e6e6e6;
+    margin-bottom: 2.2rem;
+    font-family: var(--body-font);
+}
+.nav-category-scroll {
+    overflow-x: auto;
+    white-space: nowrap;
+}
+.nav-category-scroll::-webkit-scrollbar {
+    display: none;
+}
+.nav-category-bar .nav-link {
+    color: #757575;
+    font-weight: 500;
+    font-size: 1rem;
+    margin-right: 6px;
+    padding: 14px 20px 14px 0;
+    display: inline-block;
+    min-width: max-content;
+}
+.nav-category-bar .nav-link.active, .nav-category-bar .nav-link:focus, .nav-category-bar .nav-link:hover {
+    color: #000;
+    border-bottom: 2.5px solid #000;
+    background: none;
+}
+.nav-category-bar .category-arrow {
+    font-size: 1.1rem;
+    vertical-align: middle;
+    color: #757575;
+    margin-left: 0.2rem;
+}
+/* Main Content */
+.main-content {
+    margin-top: 0rem;
+}
+.center {
+    margin: auto;
+    width: 75%;
+    padding: 10px;
+}
+.post-item {
+    display: flex;
+    border-bottom: 1px solid #ececec;
+    padding-bottom: 2.2rem;
+    margin-bottom: 2.2rem;
+    gap: 1.5rem;
+    min-height: 138px;
+}
+.post-item:last-child {
+    border-bottom: 0;
+}
+.post-info {
+    flex: 1 1 0;
+    min-width: 0;
+}
+.post-title {
+    font-family: var(--body-font);
+    font-size: 1.45rem;
+    font-weight: 700;
+    color: #1a1919;
+    margin-bottom: 7px;
+    line-height: 1.19;
+    letter-spacing: -.01em;
+}
+.post-sneak {
+    color: #757575;
+    font-size: 1rem;
+    margin-bottom: 9px;
+}
+.post-meta {
+    font-size: 0.9rem;
+    color: #757575;
+    display: flex;
+    align-items: center;
+    gap: 1.1rem;
+}
+.author-avatar {
+    width: 30px;
+    height: 30px;
+    border-radius: 50%;
+    object-fit: cover;
+    margin-right: 7px;
+}
+.author-name {
+    font-size: 0.8rem;
+    margin-right: 12px;
+    color: #242424;
+}
+.post-img-thumb {
+    width: 150px;
+    height: 100px;
+    border-radius: 7px;
+    object-fit: cover;
